# Lakbay Customer Web Environment Variables
# Local dev: /api (Vite proxy -> http://localhost:5000). On Vercel set the ABSOLUTE
# backend URL in Project Settings, e.g. https://<backend-project>.vercel.app/api
VITE_API_BASE_URL=/api

# Admin/operator portal URL (used by the "Become an Operator" page)
VITE_ADMIN_URL=http://localhost:3001

# Firebase Client SDK
VITE_FIREBASE_API_KEY=AIzaSyDummyKeyForDevelopment12345
VITE_FIREBASE_AUTH_DOMAIN=lakbay-dev.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=lakbay-dev
VITE_FIREBASE_STORAGE_BUCKET=lakbay-dev.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Optional Geoapify client key for direct map tiles / markers (can also use /api/external)
VITE_GEOAPIFY_API_KEY=placeholder_geoapify_key
