# ========================================================
# LAKBAY PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env (root), or create project-specific
# .env files: ./backend/.env, ./frontend-customer/.env,
# ./frontend-admin/.env
#
# NEVER commit a real .env or serviceAccountKey.json —
# both are covered by the root .gitignore.

# --------------------------------------------------------
# 1. Server & Application Ports
# --------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PORT=5000
CUSTOMER_WEB_PORT=3000
ADMIN_PORT=3001

# --------------------------------------------------------
# 2. Application URLs (CORS & Redirections)
# --------------------------------------------------------
API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# --------------------------------------------------------
# 3. Firebase Configuration (Admin SDK for /backend)
# --------------------------------------------------------
# Option A: Path to serviceAccountKey.json (relative to backend or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Individual Firebase Admin credentials (used in Docker / CI/CD)
#FIREBASE_PROJECT_ID=lakbay-dev
#FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@lakbay-dev.iam.gserviceaccount.com
# Note: In .env, replace actual newlines with \n in the private key
#FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#FIREBASE_STORAGE_BUCKET=lakbay-dev.appspot.com

# --------------------------------------------------------
# 4. Firebase Configuration (Client SDK for Frontends)
#    (VITE_* vars are baked into the JS bundle at BUILD time)
# --------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Relative path works in dev (Vite proxy) and Docker (nginx /api proxy)
VITE_API_BASE_URL=/api

# --------------------------------------------------------
# 5. Frontend Feature Flags
# --------------------------------------------------------
# Set to "true" ONLY for local/demo builds to show the
# quick-fill admin credentials button on the staff login page.
VITE_ENABLE_DEMO_LOGIN=false
# Staff/Operator portal URL used by customer-facing links
VITE_ADMIN_URL=http://localhost:3001

# --------------------------------------------------------
# 6. Stripe Configuration (/backend)
# --------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=php

# --------------------------------------------------------
# 7. External Location & Weather APIs
# --------------------------------------------------------
# Geoapify API Key (destination search autocomplete & geocoding)
GEOAPIFY_API_KEY=
VITE_GEOAPIFY_API_KEY=

# OpenWeather API Key (destination weather & departure forecasts)
OPENWEATHER_API_KEY=

# --------------------------------------------------------
# 8. Initial Admin Account Provisioning (seed script)
#    Change ADMIN_PASSWORD before any shared/deployed use.
# --------------------------------------------------------
ADMIN_NAME=Lakbay Administrator
ADMIN_EMAIL=admin@lakbay.ph
ADMIN_PASSWORD=AdminPassword123
ADMIN_PHONE=+639171234567
