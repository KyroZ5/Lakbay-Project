{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Backend: no build step required (serverless functions)'",
  "devCommand": "echo 'Backend: use npm run dev for local development'",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "api/index.js": {
      "runtime": "nodejs@20.x",
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production",
    "PORT": "3000",
    "HOST": "0.0.0.0"
  },
  "crons": []
}
